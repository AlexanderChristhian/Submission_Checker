// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// ── Better Auth Core ───────────────────────────────────────

model user {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(STUDENT)
  emailVerified Boolean @default(false)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    session[]
  accounts    account[]
  submissions Submission[]
  grades      Grade[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

// ── Academic Structure ────────────────────────────────────

model Course {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  assignments Assignment[]
  gradingRules GradingRule[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  courseId   Int
  course    Course   @relation(fields: [courseId], references: [id])
  dueDate   DateTime?
  createdAt DateTime @default(now())

  submissions Submission[]
}

// ── Submissions ───────────────────────────────────────────

model Submission {
  id           Int              @id @default(autoincrement())
  title        String
  content      String           @db.Text
  fileName     String?
  fileUrl      String?
  status       SubmissionStatus @default(PENDING)
  chromaDocId  String?          // cross-ref → ChromaDB document
  neo4jNodeId  String?          // cross-ref → Neo4j Submission node

  userId       String
  user         user             @relation(fields: [userId], references: [id])
  assignmentId Int?
  assignment   Assignment?      @relation(fields: [assignmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades             Grade[]
  plagiarismReports  PlagiarismReport[]
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  CHECKED
  FAILED
}

// ── Grading ───────────────────────────────────────────────

model Grade {
  id           Int      @id @default(autoincrement())
  score        Float
  feedback     String?  @db.Text
  submissionId Int @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedById   String?
  gradedBy     user?    @relation(fields: [gradedById], references: [id])
  createdAt    DateTime @default(now())
}

// ── Plagiarism Reports ────────────────────────────────────

model PlagiarismReport {
  id             Int      @id @default(autoincrement())
  submissionId   Int
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  overallScore   Float      // 0–100 similarity percentage
  flagged        Boolean    @default(false)
  details        Json?      // structured match data from Neo4j/RAG
  createdAt      DateTime   @default(now())
}

// ── Grading Rules ─────────────────────────────────────────

model GradingRule {
  id        Int      @id @default(autoincrement())
  name      String
  content   String   @db.Text
  courseId   Int?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Audit Log ─────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // e.g. "submission.create", "plagiarism.check"
  entityType String? // e.g. "Submission", "Grade"
  entityId  Int?
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
}
