%% DigiChecker - Full System Architecture
%% Generated: 08-Jun-2026

---
title: DigiChecker System Architecture
---

graph TB
    subgraph Frontend["Frontend (Next.js 16)"]
        FE_Pages["App Router Pages<br/>HomePage / Submissions / Reports / Settings"]
        FE_API_Routes["Next.js API Routes<br/>/api/submissions (BFF Proxy)"]
        FE_Components["React Components<br/>Dashboard / Tables / Streaming / OCR Upload"]
    end

    subgraph Backend["Backend (Express.js 5 + TypeScript)"]
        BE_Routes["API Routes<br/>/api/submissions /courses /analytics /plagiarism"]
        BE_Controllers["Controllers<br/>Request handling & validation"]
        BE_Services["Services<br/>Submission / Analytics / Plagiarism / RAG Client"]
        BE_Graph["Graph Module<br/>Cypher queries for Neo4j analytics"]
        BE_Prisma["Prisma ORM<br/>PostgreSQL data access"]
    end

    subgraph RAG["RAG Service (Python FastAPI)"]
        RS_Routes["API Endpoints<br/>/index /query /similar /graphrag /hybrid-graph /vlm"]
        RS_Services["Services<br/>Document / Index / Query / GraphRAG / VLM"]
        RS_Retrievers["Retrievers<br/>Vector / BM25 / Hybrid / Graph"]
        RS_Neo4j["Neo4j Client<br/>Async Cypher queries"]
        RS_Embeddings["BGE-M3<br/>Dense Embeddings"]
        RS_LLM["Ollama LLM<br/>LlamaIndex integration"]
    end

    subgraph Storage["Data Layer"]
        DB_PG[("PostgreSQL<br/>Relational Data")]
        DB_NEO4J[("Neo4j<br/>Knowledge Graph")]
        DB_CHROMA[("ChromaDB<br/>Vector Store")]
    end

    subgraph External["External Services"]
        EXT_VLM["VLM APIs<br/>GPT-4o / Claude / Gemini"]
        EXT_OLLAMA["Ollama<br/>LLM Host"]
    end

    subgraph DevOps["DevOps & Deployment"]
        DOCKER["Docker Compose<br/>4-service stack"]
        K8S["Kubernetes<br/>Auto-scaling / Probes / HPA"]
    end

    %% Data Flow
    FE_Pages -->|"fetch(/api/submissions)"| FE_API_Routes
    FE_API_Routes -->|"proxy to :3001"| BE_Routes

    BE_Routes --> BE_Controllers
    BE_Controllers --> BE_Services
    BE_Services -->|"Prisma"| BE_Prisma
    BE_Prisma --> DB_PG
    BE_Services -->|"Cypher"| BE_Graph
    BE_Graph --> DB_NEO4J
    BE_Services -->|"HTTP :8000"| RS_Routes

    RS_Routes --> RS_Services
    RS_Services -->|"Index/Query"| RS_Retrievers
    RS_Retrievers -->|"Vector Search"| DB_CHROMA
    RS_Retrievers -->|"Keyword (BM25)"| RS_Embeddings
    RS_Services -->|"GraphRAG"| RS_Neo4j
    RS_Neo4j --> DB_NEO4J
    RS_Services -->|"LLM Synthesis"| RS_LLM
    RS_LLM --> EXT_OLLAMA

    RS_Services -->|"OCR"| EXT_VLM

    %% DevOps
    DOCKER -->|"orchestrates"| Frontend
    DOCKER --> Backend
    DOCKER -->|"depends_on"| RAG
    DOCKER --> DB_PG
    DOCKER --> DB_NEO4J
    K8S -->|"manages"| DOCKER

    %% Style
    classDef frontend fill:#e1f5fe,stroke:#0288d1,color:#000
    classDef backend fill:#fff3e0,stroke:#f57c00,color:#000
    classDef rag fill:#f3e5f5,stroke:#7b1fa2,color:#000
    classDef storage fill:#e8f5e9,stroke:#388e3c,color:#000
    classDef external fill:#fce4ec,stroke:#c62828,color:#000
    classDef devops fill:#f5f5f5,stroke:#616161,color:#000

    class FE_Pages,FE_API_Routes,FE_Components frontend
    class BE_Routes,BE_Controllers,BE_Services,BE_Graph,BE_Prisma backend
    class RS_Routes,RS_Services,RS_Retrievers,RS_Neo4j,RS_Embeddings,RS_LLM rag
    class DB_PG,DB_NEO4J,DB_CHROMA storage
    class EXT_VLM,EXT_OLLAMA external
    class DOCKER,K8S devops
